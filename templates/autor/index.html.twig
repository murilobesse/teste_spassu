{% extends 'base.html.twig' %}

{% block title %}Autores{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Lista de Autores</h1>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalNovoAutor">
        <i class="bi bi-plus-lg"></i> Novo Autor
    </button>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover table-striped mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Código</th>
                    <th>Nome</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
            {% for autor in autors %}
                <tr>
                    <td>{{ autor.codAu }}</td>
                    <td>{{ autor.nome }}</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-primary btn-editar-autor" 
                                data-bs-toggle="modal" 
                                data-bs-target="#modalEditarAutor"
                                data-codau="{{ autor.codAu }}" 
                                data-nome="{{ autor.nome }}">
                            Editar
                        </button>
                        <form method="post" 
                              action="{{ path('app_autor_delete', {'codAu': autor.codAu}) }}" 
                              style="display:inline;" 
                              onsubmit="return confirmarExclusao(event, '{{ autor.nome }}');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ autor.codAu) }}">
                            <button class="btn btn-sm btn-outline-danger">Excluir</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3" class="text-center text-muted">Nenhum autor encontrado.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {# Renderização da Paginação Bootstrap 5 #}
        <div class="d-flex justify-content-center mt-4">
            {{ knp_pagination_render(autors) }}
        </div>
    </div>
</div>

<!-- Modal Novo Autor -->
<div class="modal fade" id="modalNovoAutor" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Novo Autor</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                {{ include('autor/_form.html.twig', {
                    'form': form_novo,
                    'button_label': 'Cadastrar',
                    'action': path('app_autor_new')
                }) }}
            </div>
        </div>
    </div>
</div>

<!-- Modal de Edição -->
<div class="modal fade" id="modalEditarAutor" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Editar Autor</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                {{ form_start(form_editar, {'attr': {'id': 'formEditarDinamico'}}) }}
                    <div class="mb-3">
                        {{ form_label(form_editar.nome, 'Nome do Autor', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form_editar.nome, {'id': 'inputEditarNome', 'attr': {'class': 'form-control', 'placeholder': 'Ex: Albert Camus'}}) }}
                        {{ form_errors(form_editar.nome) }}
                    </div>
                    <div class="d-flex justify-content-between gap-2">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success">Atualizar</button>
                    </div>
                {{ form_end(form_editar) }}
            </div>
        </div>
    </div>
</div>

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('script_autor') }}
{% endblock %}

{% endblock %}